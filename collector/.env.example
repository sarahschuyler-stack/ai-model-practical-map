# Copy to .env for local work with `vercel dev`. Never commit .env.
# On Vercel, set these under Project > Settings > Environment Variables.

# Added automatically when you attach a Neon Postgres database from the Vercel Marketplace.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Who may open the admin dashboard. Comma-separated, case does not matter.
ADMIN_EMAILS=you@example.com

# A password you invent for the admin dashboard (at least 16 characters; it also seeds the
# cookie-signing secret, so make it a long random phrase). Change it any time in Vercel.
ADMIN_KEY=choose-a-long-random-phrase

# Optional. Where the page lives. Defaults to https://sarahschuyler-stack.github.io when unset.
# Comma-separated to allow more than one, e.g. for local testing: https://sarahschuyler-stack.github.io,http://127.0.0.1:8765
# ALLOWED_ORIGIN=https://sarahschuyler-stack.github.io
